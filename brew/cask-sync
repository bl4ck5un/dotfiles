#!/usr/bin/env bash
# Save or restore Homebrew cask list (AES-256 encrypted).
# Usage:
#   cask-sync save [file]     — encrypt installed casks to file (default: casks.txt.enc)
#   cask-sync restore [file]  — decrypt and install casks from file (default: casks.txt.enc)
#
# Manual encrypt:  openssl enc -aes-256-cbc -pbkdf2 -salt -in casks.txt -out casks.txt.enc
# Manual decrypt:  openssl enc -d -aes-256-cbc -pbkdf2 -in casks.txt.enc

set -euo pipefail

DEFAULT_FILE="$(dirname "$0")/casks.txt.enc"
CMD="${1:-}"
FILE="${2:-$DEFAULT_FILE}"

usage() {
  echo "Usage: $(basename "$0") <save|restore> [file]"
  exit 1
}

case "$CMD" in
  save)
    brew list --cask | sort \
      | openssl enc -aes-256-cbc -pbkdf2 -salt -out "$FILE"
    echo "Saved and encrypted to $FILE"
    ;;
  restore)
    [[ -f "$FILE" ]] || { echo "File not found: $FILE"; exit 1; }
    tmp="$(mktemp -t cask-sync.XXXXXX)"
    trap 'rm -f "$tmp"' EXIT
    openssl enc -d -aes-256-cbc -pbkdf2 -in "$FILE" -out "$tmp"
    "${EDITOR:-vi}" "$tmp"
    IFS=$'\n' read -r -d '' -a casks < <(grep -v '^[[:space:]]*\(#\|$\)' "$tmp" && printf '\0')
    installed_list="$(brew list --cask)"
    already=()
    to_install=()
    for cask in "${casks[@]}"; do
      if grep -qxF "$cask" <<<"$installed_list"; then
        already+=("$cask")
      else
        to_install+=("$cask")
      fi
    done
    echo "Already installed: ${#already[@]}"
    echo "To install: ${#to_install[@]}"
    if [[ ${#to_install[@]} -eq 0 ]]; then
      echo "Nothing to do."
      exit 0
    fi
    printf '  - %s\n' "${to_install[@]}"
    reply=""
    read -r -p "Proceed with install? [y/N] " reply </dev/tty || true
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
    total=${#to_install[@]}
    failed=()
    for i in "${!to_install[@]}"; do
      cask="${to_install[$i]}"
      printf '\n[%d/%d] %s\n' "$((i + 1))" "$total" "$cask"
      if ! brew install --cask "$cask"; then
        failed+=("$cask")
      fi
    done
    echo
    echo "Installed: $((total - ${#failed[@]}))/$total"
    if [[ ${#failed[@]} -gt 0 ]]; then
      echo "Failed:"
      printf '  - %s\n' "${failed[@]}"
      exit 1
    fi
    ;;
  *)
    usage
    ;;
esac
